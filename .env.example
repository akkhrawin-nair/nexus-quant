# Local personal-use defaults. Copy to .env only when overrides are needed.
# Optional read-only Alpaca OPRA options quotes (requires account/data permissions).
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# Setup: docs/options-data-setup.md
# Optional Webull credential prerequisites (readiness check only; live feed not implemented).
# Keep actual values in the root .env, never in frontend/VITE_ variables.
# WEBULL_APP_KEY=
# WEBULL_APP_SECRET=
# Setup: docs/webull-thailand-options-setup.md
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_ENGINE=sqlite
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SQLITE_PATH=C:/path/to/db.sqlite3
# MARKET_CACHE_PATH=C:/path/to/writable/yfinance-cache
# Required if DJANGO_DEBUG=0; generate a private random value.
# DJANGO_SECRET_KEY=
# Optional SQL Server: install requirements-mssql.txt and use a fresh database.
# DATABASE_ENGINE=mssql
# DATABASE_NAME=KappaResearch
# DATABASE_HOST=.\SQLEXPRESS
# DATABASE_DRIVER=ODBC Driver 17 for SQL Server
# DATABASE_OPTIONS=Trusted_Connection=yes;
